#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <1 3>;
            layers = <0>;
            bindings = <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        bluetooth_layer {
            bindings = <
                &bt BT_NXT  &none  &bt BT_PRV  &none
            >;
        };
    };
};
